<resources>
    <style name="Theme.MeshCrowd" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_dark_bg</item>
        <item name="android:statusBarColor">@color/brand_dark_bg</item>
        <item name="android:navigationBarColor">@color/brand_dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="alertDialogTheme">@style/Theme.MeshCrowd.Dialog</item>
    </style>

    <style name="Theme.MeshCrowd.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#DBDEE1</item>
        <item name="colorAccent">#2DD4BF</item>
    </style>
</resources>
