{
  "name": "dismesh",
  "version": "0.9.0",
  "license": "GPL-3.0-only",
  "description": "Self-hosted chat platform (server + web client + Electron shell)",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "electron": "electron electron/main.js",
    "build:portable": "node scripts/build-portable.js",
    "build:client": "node scripts/build-client.js",
    "fetch:php": "node scripts/fetch-php.js",
    "test": "node --test \"server/test/*.test.js\" \"web/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "bcryptjs": "^2.4.3",
    "codemirror": "5.65.18",
    "dompurify": "^3.4.17",
    "express": "^4.19.2",
    "libsodium-wrappers-sumo": "^0.8.4",
    "multer": "^2.0.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "sqlite": "^5.1.1",
    "tinymce": "8.10.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "playwright": "^1.64.1",
    "rcedit": "^5.0.2"
  }
}
